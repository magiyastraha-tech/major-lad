<?xml version="1.0" encoding="utf-8"?>
<!-- Версия для преподавателя: кнопки «звук» и «камера». Видео ученика
     преподавателю не показывается — он его не видит, а картинка идёт
     только в одну сторону: от преподавателя к ученику. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ждём ученика"
        android:textColor="#e6e6ef"
        android:textSize="17sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/videoStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Камера выключена"
        android:textColor="#8f8f9c"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:contentDescription="Микрофон выключен"
            android:text="Звук\nвыкл"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:contentDescription="Камера выключена"
            android:text="Камера\nвыкл"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnMetro"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:contentDescription="Метроном выключен"
            android:text="Метроном\nвыкл"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/editBpm"
            android:text="Темп"
            android:textColor="#b9b9c6"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editBpm"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Темп в ударах в минуту"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:text="90" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/editBeats"
            android:text="Доли в такте"
            android:textColor="#b9b9c6"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editBeats"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Количество долей в такте"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:text="4" />
    </LinearLayout>

</LinearLayout>
