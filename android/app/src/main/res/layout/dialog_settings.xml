<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Общее"
            android:textColor="#e6e6ef"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="Как вас зовут"
            android:hint="Как вас зовут"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/ipRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Адрес преподавателя"
                android:hint="Адрес преподавателя, например 192.168.1.42"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textSize="17sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/editPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="Порт"
            android:hint="Порт, обычно 45801"
            android:importantForAutofill="no"
            android:inputType="number"
            android:singleLine="true"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/ownAddressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@+id/editOwnAddress"
                android:text="Мой адрес, который назвать ученику"
                android:textColor="#b9b9c6"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/editOwnAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="Адрес телефона, который назвать ученику"
                android:hint="например 192.168.1.3"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/ownAddressInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#8f8f9c"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Выбор микрофона"
            android:textColor="#e6e6ef"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="Выбор микрофона"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Динамики или наушники"
            android:textColor="#e6e6ef"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="Динамики или наушники"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Новые настройки микрофона и наушников применятся со следующего подключения."
            android:textColor="#8f8f9c"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/videoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Видео"
            android:textColor="#e6e6ef"
            android:textSize="17sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/boxVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="Отправлять видео с камеры собеседнику"
            android:minHeight="48dp"
            android:text="Отправлять видео с камеры"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/videoNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Видео идёт в обе стороны: вы видите собеседника, а он видит вас."
            android:textColor="#8f8f9c"
            android:textSize="15sp" />

        <!-- Только у ученика: отключает видео целиком и убирает кнопку
             камеры с главного экрана. У преподавателя прячется в коде. -->
        <CheckBox
            android:id="@+id/boxVideoDisabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="Отключить видео и убрать кнопку камеры"
            android:minHeight="48dp"
            android:text="Отключить видео"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/videoDisabledNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Если включено, кнопки камеры не будет и видео от вас не пойдёт."
            android:textColor="#8f8f9c"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Запись лога"
            android:textColor="#e6e6ef"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Запись выключена"
            android:textColor="#b9b9c6"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLogStart"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="Начать запись лога"
                android:text="Начать запись"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnLogStop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="Остановить запись лога"
                android:text="Остановить"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLogShare"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="Отправить лог"
            android:text="Отправить лог"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Включите запись перед занятием, повторите занятие, потом остановите и нажмите «Отправить лог» — выберите Telegram и отправьте файл преподавателю."
            android:textColor="#8f8f9c"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
