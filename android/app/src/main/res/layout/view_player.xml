<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Добавить трек" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:contentDescription="Импортировать треки от собеседника"
            android:text="Импорт трека" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="Удалить выбранный трек"
            android:text="Удалить трек" />
    </LinearLayout>

    <TextView
        android:id="@+id/trackName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:text="Трек не выбран"
        android:textColor="#e6e6ef"
        android:textSize="17sp" />

    <ListView
        android:id="@+id/trackList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="#1e1e26"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:contentDescription="Перемотка назад"
            android:text="Назад"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:contentDescription="Играть или остановить"
            android:text="Играть"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:contentDescription="Перемотка вперёд"
            android:text="Вперёд"
            android:textSize="16sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekTrack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:contentDescription="Позиция трека"
        android:max="1000"
        android:progress="0" />

    <TextView
        android:id="@+id/trackStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Треков пока нет. Нажмите «Добавить трек»."
        android:textColor="#8f8f9c"
        android:textSize="15sp" />

</LinearLayout>
