<?xml version="1.0" encoding="utf-8"?>
<!-- Версия для ученика: вместо подписей — крупные картинки-кнопки.
     Буква внутри кнопки и есть картинка: З — звук, В — видео, М — метроном.
     Включено — ярко-красная, выключено — бледно-серая. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/connectPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/editHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Адрес преподавателя, например 192.168.1.42"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/editPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Порт"
            android:importantForAutofill="no"
            android:inputType="number"
            android:singleLine="true"
            android:text="45801"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Как вас зовут"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Подключиться"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Не подключено"
        android:textColor="#e6e6ef"
        android:textSize="17sp" />

    <FrameLayout
        android:id="@+id/videoBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="#000000"
        android:minHeight="140dp">

        <ImageView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Видео преподавателя"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/videoHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="Видео преподавателя"
            android:textColor="#8f8f9c"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pic_off"
            android:contentDescription="Звук"
            android:minWidth="0dp"
            android:text="З"
            android:textColor="#ffffff"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnExpand"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pic_off"
            android:contentDescription="Видео на весь экран"
            android:minWidth="0dp"
            android:text="В"
            android:textColor="#ffffff"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMetro"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pic_off"
            android:contentDescription="Метроном"
            android:minWidth="0dp"
            android:text="М"
            android:textColor="#ffffff"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/editBpm"
            android:text="Темп"
            android:textColor="#b9b9c6"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editBpm"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Темп в ударах в минуту"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:text="90" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/editBeats"
            android:text="Доли в такте"
            android:textColor="#b9b9c6"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editBeats"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Количество долей в такте"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:text="4" />
    </LinearLayout>

</LinearLayout>
